# Environment variables example
# Copy this file to .env and fill in your values

# Application Settings
SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=False
APP_NAME=ExamGenius API
APP_VERSION=1.0.0

# API Configuration
API_V1_PREFIX=/api/v1

# Security
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/ExamgeniusDB

# Database Auto-Sync (set to true in production to auto-import questions)
DB_AUTO_SYNC=false

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here

# Email Configuration (Optional)
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-specific-password
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_FROM=noreply@examgenius.com
MAIL_FROM_NAME=ExamGenius
SENDER_EMAIL=${MAIL_USERNAME}
SENDER_PASSWORD=${MAIL_PASSWORD}
DEV_MODE=true
BASE_URL=http://localhost:8000

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
