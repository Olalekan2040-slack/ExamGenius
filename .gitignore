# ============================================================
# Project Specific
# ============================================================
# Add project-specific files below
# /path/to/sensitive/config
# /local/test/data

# JAMB source data folder (large, not needed in repo)
JAMB/
JAMB copy/

# Static images (generated from JAMB folder) — included in repo for deployment
# static/images/   ← un-commented to allow question images to be deployed
static/uploads/

# Syllabus markdown files (reference only) - but keep parsed JSON
syllabus/*.md
!syllabus/parsed/

# Past questions JSON (imported to database)
past_questions/

# Database files
*.db
*.db-journal
*.sqlite
*.sqlite3

# Script outputs and test files
check_*.py
test_*.py
cleanup_*.py

# Documentation that's auto-generated or temporary
*_IMPLEMENTATION*.md
*_CHECKLIST*.md
*_DELIVERY*.md
*_SETUP*.md
*_COMPLETE*.md
*_SUMMARY*.md
*_REFERENCE*.md
*_GUIDE*.md
TROUBLESHOOTING*.md
QUICK_START*.md
DEEPSEEK*.md

nohup.out

frontend/.vite/
nohup.out
