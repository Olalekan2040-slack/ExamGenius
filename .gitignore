# ============================================================
# EDULAB EXAMPREP - GITIGNORE
# Comprehensive ignore rules for Python, Node, IDE, OS
# ============================================================

# ============================================================
# Python
# ============================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv
venv/
env.bak/
venv.bak/

# PyCharm & IDEs
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# ============================================================
# Database
# ============================================================
*.db
*.sqlite
*.sqlite3
jamb_questions.db
*.sqlite-journal

# ============================================================
# Environment & Secrets
# ============================================================
.env
.env.local
.env.*.local
.env.production
.env.development
.env.test
# Note: .env.example is NOT ignored - it should be committed
secrets/
*.pem
*.key
*.pfx

